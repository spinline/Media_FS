# ==============================================================================
# Media_FS Jellyfin Docker Yapılandırması
# Bu dosyayı .env olarak kopyalayın ve bilgilerinizi girin: cp .env.example .env
# ==============================================================================

# Jellyfin Sunucu Bilgileri (URL zorunludur)
JELLYFIN_URL=http://192.168.1.100:8096
JELLYFIN_ALIAS=Jellyfin

# Kimlik Doğrulama Yöntemi 1: Kullanıcı adı ve Parola
JELLYFIN_USERNAME=kullanici_adiniz
JELLYFIN_PASSWORD=guclu_parolaniz

# Kimlik Doğrulama Yöntemi 2: API Anahtarı (Parola yerine kullanılabilir)
# JELLYFIN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NAS Ana Makine Mount Noktası (Fygos NAS arayüzünden erişim için /vol1/1000/Docker/mediafs)
HOST_MOUNT_POINT=/vol1/1000/Docker/mediafs

# FUSE Mount Seçenekleri (Salt okunur ve NAS üzerindeki tüm kullanıcılara erişim)
MOUNT_OPTIONS=ro,allow_other

# Performans ve Önbellek Ayarları
# Bir HTTP Range isteği ve önbellek blok boyutu (MB)
CHUNK_SIZE_MB=64

# Eşzamanlı indirilecek / ileriye dönük okunacak parça sayısı
PARALLEL_CHUNKS=4

# Bellek içi video pencere önbelleği üst sınırı (MB)
MAX_CACHE_MB=2048

# Önbellekteki parçaların saklanma süresi (dakika)
CACHE_TTL_MIN=120
